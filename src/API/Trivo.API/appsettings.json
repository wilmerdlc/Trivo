{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TrivoContext": "Host=localhost;Port=5432;Database=trivo;Username=CHANGE_ME;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },
  "EmailSetting": {
    "EmailFrom": "CHANGE_ME@example.com",
    "SmtpHost": "CHANGE_ME",
    "SmtpPort": 587,
    "SmtpUser": "CHANGE_ME",
    "SmtpPassword": "CHANGE_ME",
    "DisplayName": "Trivo"
  },
  "CloudinarySetting": {
    "CloudinaryUrl": "cloudinary://CHANGE_ME"
  },
  "JwtSetting": {
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET",
    "Issuer": "Trivo.API",
    "Audience": "Trivo.Client",
    "DurationInMinutes": 60
  },
  "AiSetting": {
    "Model": "gpt-4o-mini",
    "ApiKey": "CHANGE_ME"
  }
}
